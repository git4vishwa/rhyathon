# Copy to .env only if your launcher/process manager loads it. Do not commit real secrets.
# Canonical origin of the ZeroTrace dashboard when deployed behind a reverse proxy.
ZT_APP_ORIGIN=https://analytics.example.org
# Enable Secure on the owner session cookie in production HTTPS deployments.
ZT_COOKIE_SECURE=true
# Use a persistent, protected disk/volume path for the SQLite database.
ZT_DATABASE_PATH=/var/lib/zerotrace/zerotrace.sqlite3
ZT_RETENTION_DAYS=365
# Generate a unique high-entropy value for your deployment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
ZT_RATE_LIMIT_SECRET=replace-with-a-random-secret
